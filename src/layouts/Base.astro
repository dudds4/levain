---
import '../styles/global.css';
import { url } from '../lib';

interface Props {
	title?: string;
	description?: string;
}

const siteName = 'David Weisdorf';
const { title, description = 'Projects and writing by David Weisdorf.' } = Astro.props;
const fullTitle = title ? `${title} · ${siteName}` : siteName;
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="icon" type="image/svg+xml" href={url('favicon.svg')} />
		<link rel="icon" href={url('favicon.ico')} />
		<link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
		<meta name="description" content={description} />
		<meta name="generator" content={Astro.generator} />
		<title>{fullTitle}</title>
	</head>
	<body>
		<header class="wrap site-header">
			<a href={url('/')} class="brand">{siteName}</a>
			<nav>
				<a href={url('/')}>Projects</a>
				<a href={url('about/')}>About</a>
			</nav>
		</header>
		<main class="wrap">
			<slot />
		</main>
		<footer class="wrap muted">
			<a href="https://github.com/dudds4">GitHub</a>
		</footer>
	</body>
</html>

<style>
	.site-header { display: flex; justify-content: space-between; align-items: center; padding-top: 1.5rem; padding-bottom: 1.5rem; }
	.brand { color: var(--fg); font-weight: 600; text-decoration: none; }
	nav { display: flex; gap: 1rem; }
	nav a { color: var(--muted); text-decoration: none; }
	nav a:hover { color: var(--fg); }
	footer { padding-top: 3rem; padding-bottom: 2rem; font-size: 0.9rem; }
</style>
